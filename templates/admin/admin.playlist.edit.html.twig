{% extends "baseadmin.html.twig" %}

{% block body %}
    <h2>Détail Playlist :</h2>
  
<div class="row">
    <div class="col">
       {{ form_start(formPlaylist) }}
       {{ form_end(formPlaylist) }}
    </div>
    <div class="col">
            <!-- boucle sur l'affichage des formations -->
            <h5>Formations dans la playlist :</h5>
            {% for formation in playlistformations %}
                <div class="row mt-1">
                    <div class="col-md-auto">
                        {% if formation.miniature %}
                                <img src="{{ formation.miniature }}" alt = "miniatures des formations">
                        {% endif %}  
                    </div>
                    <div class="col d-flex align-items-center">
                        <a class="link-secondary text-decoration-none">
                            {{ formation.title }}
                        </a>          
                    </div>
                </div>
            {% endfor %}
        </div>
    
</div>

{% endblock %}
